  "db_name": "PostgreSQL",
  "query": "\n            SELECT d._id, d.title,\n                COALESCE((SELECT array_agg(m.group_id ORDER BY m.position)\n                          FROM document_group_members m WHERE m.document_id = d._id), '{}')\n                    AS \"group_ids!\"\n            FROM documents d\n            WHERE d.deleted_at IS NULL\n            ",
