{{- $env := envFile "../.env" -}}
{{- $config :=  yamlFile "../config.yml" -}}

MONGODB_ROOT_PASSWORD_QA={{- randAlpha 100 -}}
# Postgres: the owner (POSTGRES_USER of qa-pg) and the role the server connects as. Letters
# only (randAlpha), as the app password goes into a URL unencoded; on an existing deployment
# add them with add-postgres-secrets.sh instead of rendering this file again.
POSTGRES_PASSWORD_QA={{- randAlpha 100 -}}
POSTGRES_APP_PASSWORD_QA={{- randAlpha 100 -}}
# The server image's tag (the short sha of a CI build) is no secret, but compose reads it
# from this file too: `bash set-server-image.sh results/.env <short sha>` (README "Server image").
{{- if eq $config.interossea.server.create true }}
MONGODB_ROOT_PASSWORD_INTEROSSEA={{- randAlpha 100 -}}
{{- end }}
INTEROSSEA_MAIL_PASSWORD={{ $env.INTEROSSEA_MAIL_PASSWORD }}

BACKUP_AWS_ACCESS_KEY_ID={{ $env.BACKUP_AWS_ACCESS_KEY_ID }}
BACKUP_AWS_SECRET_ACCESS_KEY={{ $env.BACKUP_AWS_SECRET_ACCESS_KEY }}
BACKUP_AWS_S3_BUCKET_NAME={{ $env.BACKUP_AWS_S3_BUCKET_NAME }}
BACKUP_ENCRYPTION_PASSWORD={{ $env.BACKUP_ENCRYPTION_PASSWORD }}

MATTERMOST_POSTGRES_USER={{- randAlpha 10 -}}
MATTERMOST_POSTGRES_PASSWORD={{- randAlpha 100 -}}


MM_EMAILSETTINGS_SMTPSERVER=mx.vindelicum.eu
MM_EMAILSETTINGS_SMTPPORT=587
MM_EMAILSETTINGS_SMTPUSERNAME=no-reply@queer-augsburg.de
MM_EMAILSETTINGS_CONNECTIONSECURITY=TLS